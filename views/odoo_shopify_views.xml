<!-- File: odoo_shopify_views.xml -->
<odoo>
    <!-- Views for odoo.sync (Odoo to Shopify) -->
    <record id="view_odoo_sync_form" model="ir.ui.view">
        <field name="name">odoo.sync.form</field>
        <field name="model">odoo.sync</field>
        <field name="arch" type="xml">
            <form string="Odoo to Shopify Sync">
                <header>
                    <button name="sync_products_to_shopify" string="Sync All Products" type="object" class="oe_highlight"/>
                    <button name="test_connection" string="Test Shopify Connection" type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Odoo to Shopify Synchronization</h1>
                    </div>
                    <group>
                        <group>
                            <field name="last_sync_date" readonly="1"/>
                            <field name="products_synced" readonly="1"/>
                        </group>
                        <group>
                            <field name="auto_sync_enabled"/>
                            <field name="sync_interval" attrs="{'invisible': [('auto_sync_enabled', '=', False)]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Settings">
                            <group>
                                <group string="Shopify API Settings">
                                    <field name="shopify_url"/>
                                    <field name="api_key"/>
                                    <field name="api_secret" password="True"/>
                                    <field name="api_version"/>
                                </group>
                                <group string="Sync Settings">
                                    <field name="batch_size"/>
                                    <field name="auto_publish_products"/>
                                    <field name="sync_inventory"/>
                                    <field name="sync_images"/>
                                </group>
                            </group>
                        </page>
                        <page string="Sync History">
                            <field name="sync_history_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="status"/>
                                    <field name="products_count"/>
                                    <field name="message"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Logs">
                            <field name="log_ids" readonly="1">
                                <tree>
                                    <field name="create_date"/>
                                    <field name="product_id"/>
                                    <field name="operation"/>
                                    <field name="status"/>
                                    <field name="message"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_odoo_sync_tree" model="ir.ui.view">
        <field name="name">odoo.sync.tree</field>
        <field name="model">odoo.sync</field>
        <field name="arch" type="xml">
            <tree string="Odoo to Shopify Sync">
                <field name="shopify_url"/>
                <field name="last_sync_date"/>
                <field name="products_synced"/>
                <field name="auto_sync_enabled"/>
            </tree>
        </field>
    </record>

    <!-- Views for shopify.sync (Shopify to Odoo) -->
    <record id="view_shopify_sync_form" model="ir.ui.view">
        <field name="name">shopify.sync.form</field>
        <field name="model">shopify.sync</field>
        <field name="arch" type="xml">
            <form string="Shopify to Odoo Sync">
                <header>
                    <button name="sync_products_to_odoo" string="Import Products" type="object" class="oe_highlight"/>
                    <button name="test_connection" string="Test Shopify Connection" type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Shopify to Odoo Synchronization</h1>
                    </div>
                    <group>
                        <group>
                            <field name="last_sync_time" readonly="1"/>
                            <field name="products_synced" readonly="1"/>
                        </group>
                        <group>
                            <field name="auto_sync_enabled"/>
                            <field name="sync_interval" attrs="{'invisible': [('auto_sync_enabled', '=', False)]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Settings">
                            <group>
                                <group string="Shopify API Settings">
                                    <field name="shopify_url"/>
                                    <field name="api_key"/>
                                    <field name="api_secret" password="True"/>
                                    <field name="api_version"/>
                                </group>
                                <group string="Import Settings">
                                    <field name="batch_size"/>
                                    <field name="import_images"/>
                                    <field name="sync_inventory"/>
                                    <field name="create_categories"/>
                                </group>
                            </group>
                        </page>
                        <page string="Import History">
                            <field name="sync_history_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="status"/>
                                    <field name="products_count"/>
                                    <field name="message"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Logs">
                            <field name="log_ids" readonly="1">
                                <tree>
                                    <field name="create_date"/>
                                    <field name="shopify_product_id"/>
                                    <field name="operation"/>
                                    <field name="status"/>
                                    <field name="message"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shopify_sync_tree" model="ir.ui.view">
        <field name="name">shopify.sync.tree</field>
        <field name="model">shopify.sync</field>
        <field name="arch" type="xml">
            <tree string="Shopify to Odoo Sync">
                <field name="shopify_url"/>
                <field name="last_sync_time"/>
                <field name="products_synced"/>
                <field name="auto_sync_enabled"/>
            </tree>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_odoo_sync" model="ir.actions.act_window">
        <field name="name">Odoo to Shopify</field>
        <field name="res_model">odoo.sync</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_shopify_sync" model="ir.actions.act_window">
        <field name="name">Shopify to Odoo</field>
        <field name="res_model">shopify.sync</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_shopify_integration" name="Shopify Integration" parent="sale.menu_sale_config" sequence="99"/>
    <menuitem id="menu_odoo_sync" name="Export to Shopify" parent="menu_shopify_integration" action="action_odoo_sync" sequence="10"/>
    <menuitem id="menu_shopify_sync" name="Import from Shopify" parent="menu_shopify_integration" action="action_shopify_sync" sequence="20"/>

    <!-- Product Buttons -->
    <record id="product_normal_form_view_shopify_buttons" model="ir.ui.view">
        <field name="name">product.product.form.shopify.buttons</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button 
                    name="sync_to_shopify" 
                    type="object" 
                    class="oe_stat_button" 
                    icon="fa-shopping-cart"
                    string="Sync to Shopify"
                    attrs="{'invisible': [('active', '=', False)]}"
                />
            </div>
        </field>
    </record>

    <record id="product_template_form_view_shopify_buttons" model="ir.ui.view">
        <field name="name">product.template.form.shopify.buttons</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button 
                    name="sync_to_shopify" 
                    type="object" 
                    class="oe_stat_button" 
                    icon="fa-shopping-cart"
                    string="Sync to Shopify"
                    attrs="{'invisible': [('active', '=', False)]}"
                />
            </div>
        </field>
    </record>
</odoo>