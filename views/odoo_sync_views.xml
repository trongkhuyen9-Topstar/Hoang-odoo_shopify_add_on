<odoo>
    <record id="view_odoo_sync_tree" model="ir.ui.view">
        <field name="name">odoo.sync.tree</field>
        <field name="model">odoo.sync</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="sync_status"/>
                <field name="sync_date"/>
            </tree>
        </field>
    </record>

    <record id="view_odoo_sync_form" model="ir.ui.view">
        <field name="name">odoo.sync.form</field>
        <field name="model">odoo.sync</field>
        <field name="arch" type="xml">
            <form string="Odoo Sync">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="sync_status" readonly="1"/>
                        <field name="sync_date" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoo_sync" model="ir.actions.act_window">
        <field name="name">Odoo Sync</field>
        <field name="res_model">odoo.sync</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_odoo_sync" name="Odoo Sync" parent="base.menu_management" action="action_odoo_sync"/>
</odoo>
