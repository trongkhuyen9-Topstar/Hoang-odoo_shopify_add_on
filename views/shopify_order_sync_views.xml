<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View for shopify.order.status -->
        <record id="view_shopify_order_status_tree" model="ir.ui.view">
            <field name="name">shopify.order.status.tree</field>
            <field name="model">shopify.order.status</field>
            <field name="arch" type="xml">
                <tree string="Shopify Order Statuses" default_order="last_sync_date desc">
                    <field name="name"/>
                    <field name="shopify_order_id"/>
                    <field name="shopify_order_number"/>
                    <field name="shopify_financial_status"/>
                    <field name="shopify_fulfillment_status"/>
                    <field name="odoo_order_id" optional="show"/>
                    <field name="last_sync_date"/>
                </tree>
            </field>
        </record>

        <!-- Form View for shopify.order.status -->
        <record id="view_shopify_order_status_form" model="ir.ui.view">
            <field name="name">shopify.order.status.form</field>
            <field name="model">shopify.order.status</field>
            <field name="arch" type="xml">
                <form string="Shopify Order Status">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="shopify_order_id" readonly="1"/>
                                <field name="shopify_order_number" readonly="1"/>
                                <field name="odoo_order_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="shopify_financial_status" readonly="1"/>
                                <field name="shopify_fulfillment_status" readonly="1"/>
                                <field name="last_sync_date" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                             <page string="Raw Data" name="raw_data">
                                 <field name="raw_shopify_data" readonly="1"/>
                             </page>
                         </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for Shopify Order Status Menu -->
        <record id="action_shopify_order_status" model="ir.actions.act_window">
            <field name="name">Shopify Order Statuses</field>
            <field name="res_model">shopify.order.status</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Shopify order statuses found. Run the sync process.
                </p>
            </field>
        </record>

        <!-- Menu Item under Shopify Sync -->
        <!-- Assuming a top-level menu 'menu_shopify_root' exists -->
        <!-- Adjust the 'parent' attribute below if your root menu ID is different -->
        <menuitem
            id="menu_shopify_order_status"
            name="Order Statuses"
            parent="menu_shopify_sync"
            action="action_shopify_order_status"
            sequence="20"/>
        <!-- Cron Job for Auto Sync -->
        <record id="ir_cron_sync_shopify_order_status" model="ir.cron">
            <field name="name">Shopify: Sync Order Statuses</field>
            <field name="model_id" ref="model_shopify_order_status"/>
            <field name="state">code</field>
            <field name="code">model._auto_sync_order_statuses()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">4</field> <!-- Adjust frequency as needed -->
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="False"/> <!-- Set to False initially if preferred -->
        </record>

    </data>
</odoo>